<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- App Store export used by .github/workflows/release-build.yml. Mirrors the
     manual-signing settings in project.yml (team, profile) — keep them in sync.
     destination=upload sends the build straight to TestFlight with the ASC API
     key the workflow passes; no .ipa is written. For a one-off local .ipa, export
     with -exportOptionsPlist <(plutil -replace destination -string export -o - ExportOptions.plist).
     manageAppVersionAndBuildNumber=false keeps xcodebuild from rewriting the
     build number the archive was stamped with, which prepare_release.py then
     looks the build up by. -->
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>5ZH48MPAM3</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>games.paperballoon.controller</key>
		<string>Paper Balloon App Store</string>
		<key>games.paperballoon.controller.Clip</key>
		<string>Paper Balloon Clip App Store</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>

{
  "about": "Shared JoinResolver cases, run by both apps' unit tests (JoinResolverTest.kt, JoinResolverTests.swift) so the two ports can't drift apart. A resolve case expects a join (game id + best-effort room code; the URL always loads verbatim, trimmed) or a rejection. A resolveLookups case feeds the relays' answers, in relay-list order, to the decision table and expects a join (game id + the URL to load) or which failure it reports. Tests run debug builds, whose LAN dev-server allowance is deliberately not covered here.",
  "games": [
    { "id": "hexstacker", "hosts": ["hexstacker.com"] },
    { "id": "tinytrack", "hosts": ["tinytrack.paperballoon.games"] }
  ],
  "resolve": [
    { "input": "", "reject": true },
    { "input": "A3KX9p", "reject": true, "note": "bare code: the relay directory places it" },
    { "input": "https://paperballoon.games/A3KX9p", "reject": true, "note": "canonical launcher link: the relay directory places it" },
    { "input": "https://www.paperballoon.games/A3KX9p", "reject": true },
    { "input": "https://hexstacker.com/A3KX9p", "game": "hexstacker", "room": "A3KX9p" },
    { "input": "  https://hexstacker.com/A3KX9p\n", "game": "hexstacker", "room": "A3KX9p" },
    { "input": "https://HexStacker.COM/A3KX9p", "game": "hexstacker", "room": "A3KX9p" },
    { "input": "https://main.hexstacker.com/A3KX9p", "game": "hexstacker", "room": "A3KX9p", "note": "a game's subdomain is a preview of that game" },
    { "input": "https://hexstacker.com:8443/A3KX9p", "game": "hexstacker", "room": "A3KX9p" },
    { "input": "https://tinytrack.paperballoon.games/A3KX9p", "game": "tinytrack", "room": "A3KX9p" },
    { "input": "https://tinytrack-feat-drift.paperballoon.games/A3KX9p", "game": "tinytrack", "room": "A3KX9p", "note": "launcher subdomain: its prefix names the game" },
    { "input": "https://preview-x.paperballoon.games/A3KX9p", "game": "paperballoon", "room": "A3KX9p", "note": "launcher subdomain naming no game: the stand-in game" },
    { "input": "https://hexstacker.com/?room=A3KX9p&color=0", "game": "hexstacker", "room": "A3KX9p" },
    { "input": "https://hexstacker.com/play", "game": "hexstacker", "room": "", "note": "no code to show; still joins" },
    { "input": "https://hexstacker.com/A3KXIl", "game": "hexstacker", "room": "", "note": "I and l aren't Base58" },
    { "input": "https://hexstacker.com/A3KX9pq", "game": "hexstacker", "room": "" },
    { "input": "http://hexstacker.com/A3KX9p", "reject": true },
    { "input": "intent://hexstacker.com/A3KX9p", "reject": true },
    { "input": "javascript:alert(1)", "reject": true },
    { "input": "https://example.com/A3KX9p", "reject": true },
    { "input": "https://evilhexstacker.com/A3KX9p", "reject": true },
    { "input": "https://hexstacker.com.evil.com/A3KX9p", "reject": true },
    { "input": "https://evil.com%2f.hexstacker.com/A3KX9p", "reject": true, "note": "the host decodes to evil.com/…; only the hostname alphabet may suffix-match" },
    { "input": "https://user:pw@hexstacker.com/A3KX9p", "reject": true },
    { "input": "https://:pw@hexstacker.com/A3KX9p", "reject": true, "note": "any userinfo rejects, a password alone too" },
    { "input": "https://@hexstacker.com/A3KX9p", "reject": true },
    { "input": "https://hexstacker.com./A3KX9p", "reject": true, "note": "trailing-dot host is not on the list" },
    { "input": "HTTPS://hexstacker.com/A3KX9p", "game": "hexstacker", "room": "A3KX9p" },
    { "input": "https://hexstacker.com@evil.com/A3KX9p", "reject": true }
  ],
  "resolveLookups": [
    { "lookups": [{ "kind": "found", "url": "https://hexstacker.com/A3KX9p#fra-1" }], "game": "hexstacker", "url": "https://hexstacker.com/A3KX9p#fra-1" },
    { "lookups": [{ "kind": "found", "url": "https://evil.example/A3KX9p" }], "fail": "notARoom", "note": "the relay's url is untrusted: off the list, it loads nothing" },
    { "lookups": [{ "kind": "found", "url": "http://hexstacker.com/A3KX9p" }], "fail": "notARoom" },
    { "lookups": [{ "kind": "found", "url": "https://paperballoon.games/A3KX9p" }], "fail": "unmatched", "note": "an origin-less template says nothing the directory hadn't" },
    { "lookups": [{ "kind": "found" }], "fail": "unmatched", "note": "the room is there but nothing says where it lives" },
    { "lookups": [{ "kind": "found" }, { "kind": "found", "url": "https://hexstacker.com/A3KX9p#fra-1" }], "game": "hexstacker", "url": "https://hexstacker.com/A3KX9p#fra-1" },
    { "lookups": [{ "kind": "found", "url": "https://tinytrack.paperballoon.games/A3KX9p" }, { "kind": "found", "url": "https://hexstacker.com/A3KX9p#fra-1" }], "game": "tinytrack", "url": "https://tinytrack.paperballoon.games/A3KX9p", "note": "relay-list order decides" },
    { "lookups": [{ "kind": "found", "url": "https://hexstacker.com/A3KX9p#fra-1", "clients": 8, "maxClients": 8 }], "game": "hexstacker", "url": "https://hexstacker.com/A3KX9p#fra-1", "note": "a full room still takes its own players back" },
    { "lookups": [{ "kind": "error" }, { "kind": "found", "url": "https://hexstacker.com/A3KX9p#fra-1" }], "game": "hexstacker", "url": "https://hexstacker.com/A3KX9p#fra-1" },
    { "lookups": [{ "kind": "found", "url": "https://paperballoon.games/A3KX9p" }, { "kind": "notFound" }], "fail": "unmatched" },
    { "lookups": [{ "kind": "notFound" }, { "kind": "notFound" }], "fail": "notFound" },
    { "lookups": [{ "kind": "notFound" }, { "kind": "error" }], "fail": "notFound", "note": "one relay's 404 outranks another's failure" },
    { "lookups": [{ "kind": "error" }, { "kind": "error" }], "fail": "unreachable" },
    { "lookups": [], "fail": "unreachable" }
  ],
  "originlessCode": [
    { "input": "", "code": null },
    { "input": "A3KX9p", "code": "A3KX9p" },
    { "input": " A3KX9p ", "code": "A3KX9p" },
    { "input": "paperballoon.games/A3KX9p", "code": "paperballoon.games/A3KX9p", "note": "no scheme reads as a typed code" },
    { "input": "https://paperballoon.games/A3KX9p", "code": "A3KX9p" },
    { "input": "https://WWW.paperballoon.games/A3KX9p", "code": "A3KX9p" },
    { "input": "https://paperballoon.games/", "code": "" },
    { "input": "https://paperballoon.games", "code": "" },
    { "input": "https://tinytrack.paperballoon.games/A3KX9p", "code": null },
    { "input": "https://hexstacker.com/A3KX9p", "code": null }
  ]
}
